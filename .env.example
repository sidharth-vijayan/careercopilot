# Copy to .env.local and fill in. Never commit the real file.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Database ────────────────────────────────────────────────────────────────
# Project Settings → Database → Connection string.
# DATABASE_URL uses the pooler (serverless-friendly); DIRECT_URL is the direct
# connection Prisma needs for schema changes.
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# ─── AI providers ────────────────────────────────────────────────────────────
# At least one is required. With both set, Gemini is primary and Groq is the
# automatic fallback when Gemini is rate-limited or down.
GEMINI_API_KEY=
GROQ_API_KEY=

# ─── Limits ──────────────────────────────────────────────────────────────────
# AI generations per user per day. The deployment runs on your own API keys, so
# this is what stops one signed-up stranger from draining your quota.
DAILY_AI_LIMIT=20

# ─── Demo account (optional) ─────────────────────────────────────────────────
# Powers the "Try the live demo" button. Create it with: npm run seed:demo
# The seeded account is flagged read-only, so visitors can browse but not write.
DEMO_EMAIL=demo@recut.app
DEMO_PASSWORD=

# Used by the seed script (to create the demo user pre-confirmed) and by the
# "Delete account" action, which needs admin rights to remove the Supabase Auth
# record — without it the login survives deletion and the privacy policy's
# erasure promise is not kept. Read server-side only.
# Project Settings → API → service_role. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
